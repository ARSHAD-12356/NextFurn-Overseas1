# Single-page app: the React app handles routes like /office-furniture, /tv-units and
# /product/<slug> itself, so any path that is not a real file or folder is sent to index.html.
# Real files (assets, brochures PDFs, images) and folders are still served as they are.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html names the current build, so browsers must recheck it or they keep showing an old release.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
